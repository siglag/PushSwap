      "updated": 1790592727409,
      "created": 1790592509615,
      "link": null,
      "locked": false,
      "text": "Then finally, return the created node which will look like this:\n\n{\n    strategy: 1,\n    sequence: {1, 2 ,3 ,4 ,5},\n    sequence_size: 5,\n    is_bench: true\n}\n\nor NULL if there were any issues.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then finally, return the created node which will look like this:\n\n{\n    strategy: 1,\n    sequence: {1, 2 ,3 ,4 ,5},\n    sequence_size: 5,\n    is_bench: true\n}\n\nor NULL if there were any issues.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
