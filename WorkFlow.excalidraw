      "isDeleted": false,
      "boundElements": [],
      "updated": 1791018494635,
      "created": 1790584821094,
      "link": null,
      "locked": false,
      "text": "disorder < 0.2  ==> selection O(n^2) simple\n\n0.2 ≤ disorder < 0.5  ==> chunk O(n√n) medium\n\ndisorder ≥ 0.5  ==> Radix O(n log n) complex\n ",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "disorder < 0.2  ==> selection O(n^2) simple\n\n0.2 ≤ disorder < 0.5  ==> chunk O(n√n) medium\n\ndisorder ≥ 0.5  ==> Radix O(n log n) complex\n ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
