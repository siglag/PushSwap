      "isDeleted": false,
      "boundElements": [],
      "updated": 1790948430387,
      "created": 1790948271545,
      "link": null,
      "locked": false,
      "text": "But here is the trick\nthe op functions will determine whether to print or just count the operation ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "But here is the trick\nthe op functions will determine whether to print or just count the operation ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "eTsHyUWVJtnwwebO8Ru4Q",
      "type": "text",
      "x": 4129.925166009282,
      "y": 7089.299504567937,
      "width": 800,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "cross-hatch",
