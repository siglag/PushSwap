    {
      "id": "HwSE9rTpePr4jn7HTBkwy",
      "type": "text",
      "x": 3850.225153800021,
      "y": 6870.427865909987,
      "width": 1359.4000244140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#2f9e44",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
